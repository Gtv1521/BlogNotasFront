{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Angular - Brave",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "/usr/bin/brave-browser-nightly",
      "sourceMapPathOverrides": {
        "webpack:/*": "${webRoot}/*",
        "/./*": "${webRoot}/*", 
        "/src/*": "${webRoot}/*"
      }
    }
  ]
}